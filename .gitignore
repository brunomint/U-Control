# Ambiente virtual
venv/
__pycache__/
*.pyc
.pytest_cache/

# Dados de instância (banco com credenciais, gerado em runtime)
instance/

# Banco SQLite local (o schema vem de migrations/, não do arquivo em si)
*.db

# Configurações locais de ferramentas (não são convenção do projeto)
.claude/settings.local.json
.vscode/

# Estado/cache gerado em runtime pelo próprio app (não é conteúdo curado).
# Fase 5.X (JSON->SQL): esses arquivos pararam de ser lidos/escritos pelo
# app — só ficam em data_backup_pre_sql/ como rede de segurança até o
# rollout real no Pi ser validado por um tempo (ver Fase 5.7).
data_backup_pre_sql/display_log.json
data_backup_pre_sql/countdown_config.json
data_backup_pre_sql/ticker_config.json
data_backup_pre_sql/image_paths.json
data_backup_pre_sql/settings.json
data_backup_pre_sql/urls.json

# Mídia enviada pelos usuários via galeria/downloads — muda o tempo todo,
# não pertence ao histórico do git (backup deve ser feito à parte)
static/imagens/
static/audio/

# Volumes locais do docker-compose.yml (instance/, users.db, mídia) — dado
# real de quem rodou `docker compose up`, não conteúdo do projeto.
docker-data/

# Backups manuais antigos — substituídos pelo histórico do git a partir de agora
backups/
*.zip

# Metadados soltos do Android Studio (não há app fonte de verdade aqui ainda)
Android/

# Build do programa de Windows (PyInstaller/Inno Setup, ver windows/)
build/
dist/
windows/bin/

# Saíram do repositório quando ele ficou público (2026-10-21): letras das
# músicas e ordens de culto antigas, e um snippet de outro projeto
data_backup_pre_sql/
pagbank_pix_update.js

# Destino do deploy/backup (endereço e usuário do Pi): só local
scripts/pi.conf

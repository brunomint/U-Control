<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:id="@+id/igreja"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/endereco"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="36dp"
            android:textColor="#80FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnCifras"
            style="@style/BotaoGrande"
            android:text="@string/cifras" />

        <Button
            android:id="@+id/btnProximo"
            style="@style/BotaoGrande"
            android:text="@string/proximo_culto" />

        <Button
            android:id="@+id/btnAgenda"
            style="@style/BotaoGrande"
            android:text="@string/agenda" />

        <Button
            android:id="@+id/btnOperador"
            style="@style/BotaoGrande"
            android:layout_marginTop="20dp"
            android:text="@string/operador"
            app:backgroundTint="#33FFFFFF" />

        <Button
            android:id="@+id/btnTrocar"
            style="@style/BotaoDiscreto"
            android:layout_marginTop="12dp"
            android:text="@string/trocar" />
    </LinearLayout>
</ScrollView>
